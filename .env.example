# Local only — never commit real values.
# Copy: cp .env.example .env
#
# Official X API (Pay Per Use) — https://console.x.com
# 1. Create a Project/App under Pay Per Use (not Ads)
# 2. Billing → buy credits + set a spending limit
# 3. Copy App Bearer Token → X_API_BEARER_TOKEN (keep URL-encoding as shown)
# 4. Set your handle (no @) for Mark detect / reply discover

X_API_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_OPERATOR_USERNAME=
# Optional numeric id (speeds own-timeline paths)
# X_OPERATOR_USER_ID=

# Optional search window (clamped to ≤7d on recent search). Default 6h.
# X_SEARCH_WITHIN_TIME=6h
# Drop posts longer than this before triage (default 480)
# X_MAX_THREAD_CHARS=480

# LLM providers (Settings picks gemini | deepseek; keys stay on the server)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Sidecar
PORT=8787
# Unused by the SPA (API host is derived from the browser hostname).
# VITE_SIDECAR_URL=http://127.0.0.1:8787

# Auth (Google) — secrets stay on the API only. Never put these in the frontend.
# AUTH_EMAIL_WHITELIST=margin707@gmail.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Local:  http://127.0.0.1:8787/api/auth/google/callback
# Prod:   https://api.xcopilot.dev/api/auth/google/callback
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/auth/google/callback
# ALLOWED_ORIGINS=https://xcopilot.dev,https://www.xcopilot.dev
# FRONTEND_ORIGIN=http://127.0.0.1:5173

# Public bind (default 127.0.0.1). Use 0.0.0.0 only behind Cloudflare TLS.
# BIND_HOST=127.0.0.1
# AUTH_REQUIRED=1
# AUTH_REQUIRED=0 is ignored when BIND_HOST is public (0.0.0.0) — the gate stays on.
# See docs/PUBLIC_DEPLOY.md

# Auth (X identity) — uses X_API_KEY / X_API_SECRET (OAuth 1.0a). Identity only;
# Scout still uses X_API_BEARER_TOKEN. X-only login requires a handle whitelist;
# otherwise sign in with Google first, then link X.
# AUTH_X_HANDLE_WHITELIST=
# Local:  http://127.0.0.1:8787/api/auth/x/callback
# Prod:   https://api.xcopilot.dev/api/auth/x/callback
# X_OAUTH_CALLBACK=http://127.0.0.1:8787/api/auth/x/callback
