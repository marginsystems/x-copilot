# Local only — never commit real values.
# Copy: cp .env.example .env
#
# How to get cookies (Chrome / Edge / Brave while logged into https://x.com):
#   1. Open DevTools → Application → Cookies → https://x.com
#   2. Copy the Value for "auth_token"  → X_AUTH_TOKEN
#   3. Copy the Value for "ct0"         → X_CT0
#   4. Run: npm run test:session
#
# Tip: if verify fails after a while, log in again and re-copy both values.
# Do not paste cookies into chat or commit them.

X_AUTH_TOKEN=
X_CT0=

# Optional overrides (usually leave unset)
# X_BEARER_TOKEN=
# X_VIEWER_QUERY_ID=
# X_SEARCH_QUERY_ID=
# Drop posts longer than this before triage (default 480)
# X_MAX_THREAD_CHARS=480

# LLM providers (Settings picks gemini | deepseek; keys stay on the server)
# Gemini Flash (default) — Google AI Studio free tier key
GEMINI_API_KEY=
# Optional override (default: gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# DeepSeek (OpenAI-compatible chat API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Sidecar
PORT=8787
VITE_SIDECAR_URL=http://127.0.0.1:8787
