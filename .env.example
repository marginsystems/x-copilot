# Local only — never commit real values.
# Copy: cp .env.example .env
#
# Official X API (Pay Per Use) — https://console.x.com
# 1. Create a Project/App under Pay Per Use (not Ads)
# 2. Billing → buy credits + set a spending limit
# 3. Copy App Bearer Token → X_API_BEARER_TOKEN (keep URL-encoding as shown)
# Desk identity is each user's stored X handle (onboarding or X OAuth), not env.

X_API_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=

# Optional search window (clamped to ≤7d on recent search). Default 6h.
# X_SEARCH_WITHIN_TIME=6h
# Drop posts longer than this before triage (default 480)
# X_MAX_THREAD_CHARS=480

# Scout LLM — DeepSeek v4-flash (no Settings picker)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Sidecar
PORT=8787

# Analytics sidecar (loopback :8788). Independent of the API — if it is down,
# signup / takeoff still work. The API defaults ANALYTICS_URL to this host.
# Slack Incoming Webhook is optional; without it the sidecar logs events.
ANALYTICS_PORT=8788
ANALYTICS_URL=http://127.0.0.1:8788
# ANALYTICS_SECRET=
# SLACK_ANALYTICS_WEBHOOK_URL=https://hooks.slack.com/services/...
# ANALYTICS_DISABLE=1
# Unused by the SPA (API host is derived from the browser hostname).
# VITE_SIDECAR_URL=http://127.0.0.1:8787
# SPA build-time only (Workers). Defaults to G-103S1LZBF3. See docs/LEGAL_LAUNCH.md.
# VITE_GA_MEASUREMENT_ID=G-103S1LZBF3
# VITE_GSC_VERIFICATION=

# Auth (Google) — secrets stay on the API only. Never put these in the frontend.
# Signup is open (Free plan). ADMIN_EMAILS is the operator list, not a signup list.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The state cookie is host-scoped, so the callback must live on the API host.
# Defaults to http://127.0.0.1:<PORT>/api/auth/google/callback (same model as
# the X callback). Set GOOGLE_REDIRECT_URI to the API origin for prod:
#   https://api.xcopilot.dev/api/auth/google/callback (see docs/PUBLIC_DEPLOY.md)
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/auth/google/callback
# ALLOWED_ORIGINS=https://xcopilot.dev
# FRONTEND_ORIGIN=http://127.0.0.1:5173

# Public bind (default 127.0.0.1). Use 0.0.0.0 only behind Cloudflare TLS.
# BIND_HOST=127.0.0.1
# AUTH_REQUIRED=1
# AUTH_REQUIRED=0 is ignored when BIND_HOST is public (0.0.0.0) — the gate stays on.
# See docs/PUBLIC_DEPLOY.md

# Auth (X identity) — uses X_API_KEY / X_API_SECRET (OAuth 1.0a). Identity only;
# Scout still uses X_API_BEARER_TOKEN. Anyone can sign in with X or link it.
# Local:  http://127.0.0.1:8787/api/auth/x/callback
# Prod:   https://api.xcopilot.dev/api/auth/x/callback
# X_OAUTH_CALLBACK=http://127.0.0.1:8787/api/auth/x/callback

# X Activity API (post.create watch). Same grey-cloud host as Stripe — no new DNS.
# CRC + HMAC use X_API_SECRET. App bearer registers the webhook and subscriptions.
# X_ACTIVITY_WEBHOOK_URL=https://api.xcopilot.dev/api/x/activity
# After the first successful register, pin the id so boot does not POST /webhooks again:
# X_ACTIVITY_WEBHOOK_ID=
# Emergency kill-switch: X_ACTIVITY_DISABLE=1 stops all outbound XAA network calls
# (webhook registration, subscriptions, resume) without touching stored state.
# X_ACTIVITY_DISABLE=1

# Billing (Stripe) — same Mergestorm, Inc. account as mergestorm.ai is fine.
# API still boots if these are empty; Checkout returns 503 stripe_not_configured.
# ADMIN_EMAILS=margin707@gmail.com
# STRIPE_SECRET_KEY=sk_live_...          # prod sidecar (NODE_ENV=production)
# STRIPE_SECRET_KEY_DEV=sk_test_...      # local / smoke (NODE_ENV!=production)
# STRIPE_WEBHOOK_SECRET=whsec_...        # signing secret for api.xcopilot.dev — not mergestorm.ai's
# Local / NODE_ENV!=production: Checkout uses *_DEV. A lone sk_live_ is refused.
# Webhook URL: https://api.xcopilot.dev/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# STRIPE_PRICE_PULSE=price_...
# STRIPE_PRICE_RADAR=price_...
# STRIPE_PRICE_HORIZON=price_...
# Portal config that lists only these three prices (keeps mergestorm.ai plans off this desk):
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
# Optional test-mode twins (used when NODE_ENV is not production):
# STRIPE_PRICE_PULSE_DEV=price_...
# STRIPE_PRICE_RADAR_DEV=price_...
# STRIPE_PRICE_HORIZON_DEV=price_...
# STRIPE_WEBHOOK_SECRET_DEV=whsec_...
# STRIPE_PORTAL_CONFIGURATION_ID_DEV=bpc_...
# Smoke: npm run test:stripe  (needs sk_test_…; never commit .env)

