{
  "name": "x-copilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "X research + reply copilot: session search → DeepSeek drafts → Vite dashboard",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:all": "npm run dev:server & npm run dev",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "tsx --test server/src/**/*.test.ts",
    "test:session": "tsx scripts/test-session.ts",
    "test:search": "tsx scripts/test-search.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
