{
  "name": "x-copilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "X research + triage copilot: session search → DeepSeek triage → Vite dashboard",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:all": "npm run dev:server & npm run dev",
    "build:server": "npm run build:webhook && tsc -p tsconfig.server.json",
    "build:analytics": "tsc -p tsconfig.analytics.json",
    "build:webhook": "tsc -p tsconfig.webhook.json",
    "build": "npm run build:server && npm run build:analytics && tsc --noEmit -p tsconfig.json && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "deploy:workers": "vite build --config frontend/vite.config.ts && npx wrangler deploy",
    "check:file-sizes": "tsx scripts/check-file-sizes.ts",
    "test": "npm run test:unit",
    "test:x-api": "tsx scripts/test-x-api.ts",
    "test:stripe": "tsx scripts/test-stripe.ts",
    "test:search": "tsx scripts/test-search.ts",
    "probe:tags": "tsx scripts/probe-triage-tags.ts",
    "memory:reindex": "tsx scripts/reindex-memory.ts",
    "test:unit": "tsx scripts/test-inventory.ts run",
    "test:unit:list": "tsx scripts/test-inventory.ts list",
    "test:unit:coverage": "tsx scripts/test-inventory.ts coverage",
    "test:mounted": "vitest run --config frontend/vitest.mounted.config.ts",
    "test:mounted:list": "vitest list --config frontend/vitest.mounted.config.ts",
    "typecheck:mounted": "tsc --noEmit -p frontend/tsconfig.mounted.json",
    "lint:hooks": "eslint \"frontend/src/**/*.{ts,tsx}\"",
    "lint:types": "eslint --config eslint.types.config.js . --max-warnings=0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "franc-min": "^6.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.7.0"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/franc": "^5.0.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  }
}
