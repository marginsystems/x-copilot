{
  "name": "x-copilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "X research + triage copilot: session search → DeepSeek triage → Vite dashboard",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:all": "npm run dev:server & npm run dev",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "deploy:workers": "vite build && npx wrangler deploy",
    "test": "tsx --test server/src/**/*.test.ts src/**/*.test.ts",
    "test:session": "tsx scripts/test-session.ts",
    "test:search": "tsx scripts/test-search.ts",
    "probe:tags": "tsx scripts/probe-triage-tags.ts",
    "memory:reindex": "tsx scripts/reindex-memory.ts"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.2",
    "franc-min": "^6.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/franc": "^5.0.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
