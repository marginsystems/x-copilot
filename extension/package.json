{
  "name": "x-copilot-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "X Copilot side panel for x.com",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7",
    "wxt": "^0.21.4"
  }
}
